# Готовые планы тренировок: содержат данные бегуна (пол, возраст, травмы,
# место занятий). Листинг каталога запрещён, отдаём только сами .xlsx —
# ссылку на файл выдаёт plan.php вместе со статусом задачи (имя со случайным
# суффиксом). Всё остальное (логи, временные файлы) наружу не идёт.
#
# Options -Indexes завёрнут в IfModule: если хостинг не разрешает
# переопределять Options, .htaccess останется рабочим и не сломает
# скачивание плана.

<IfModule mod_autoindex.c>
  Options -Indexes
  IndexIgnore *
</IfModule>

<FilesMatch "\.(json|txt|log|php|tmp|lock)$">
Require all denied
</FilesMatch>
